{
  "name": "carefolio",
  "version": "0.1.0",
  "private": true,
  "description": "Cancer care, thoughtfully organized — medical documents, appointments, and HMO correspondence for a patient and the family who help them.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arielland/CareFolio.git"
  },
  "bugs": {
    "url": "https://github.com/arielland/CareFolio/issues"
  },
  "homepage": "https://github.com/arielland/CareFolio#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx src/core/db/migrate.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "verify:isolation": "dotenv -e .env.local -- tsx scripts/verify-isolation.mts",
    "verify:agenda": "dotenv -e .env.local -- tsx scripts/verify-agenda.mts",
    "verify:combine": "tsx scripts/verify-combine.mts",
    "verify:media-types": "tsx scripts/verify-media-types.mts",
    "verify:sharing": "dotenv -e .env.local -- tsx scripts/verify-sharing.mts",
    "verify:correspondence": "dotenv -e .env.local -- tsx scripts/verify-correspondence.mts",
    "verify:visits": "dotenv -e .env.local -- tsx scripts/verify-visits.mts",
    "verify:month": "tsx scripts/verify-month.mts",
    "verify:tabs": "dotenv -e .env.local -- tsx scripts/verify-tabs.mts",
    "verify:files": "dotenv -e .env.local -- tsx scripts/verify-files.mts",
    "verify:edit": "dotenv -e .env.local -- tsx scripts/verify-document-edit.mts",
    "verify:delete": "dotenv -e .env.local -- tsx scripts/verify-delete.mts",
    "verify:disconnected-drive": "dotenv -e .env.local -- tsx scripts/verify-disconnected-drive.mts",
    "verify:auth-linking": "dotenv -e .env.local -- tsx scripts/verify-auth-linking.mts",
    "verify:import": "dotenv -e .env.local -- tsx scripts/verify-import.mts",
    "verify:usage": "dotenv -e .env.local -- tsx scripts/verify-usage.mts",
    "verify:scan-scope": "dotenv -e .env.local -- tsx scripts/verify-scan-scope.mts",
    "probe:sharing": "dotenv -e .env.local -- tsx scripts/probe-google-sharing.mts",
    "probe:gmail": "dotenv -e .env.local -- tsx scripts/probe-gmail.mts",
    "rotate:credentials": "dotenv -e .env.local -- tsx scripts/rotate-credentials.mts",
    "backfill:contacts": "dotenv -e .env.local -- tsx scripts/backfill-contacts.mts",
    "backfill:actions": "dotenv -e .env.local -- tsx scripts/backfill-action-items.mts",
    "import:documents": "dotenv -e .env.local -- tsx scripts/import-documents.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/drizzle-adapter": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.25",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
