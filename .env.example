# Most of these are managed by Vercel. Run `vercel env pull` to refresh .env.local
# rather than editing values by hand — a pull overwrites the file, so anything that
# lives only locally is lost. Put shared secrets in Vercel with `vercel env add`.
#
# **Delete a line you do not want; do not blank it.** `KEY=` and `KEY=""` both set the
# variable to an empty string, and `??` does not treat an empty string as absent — so
# `process.env.LOG_LEVEL ?? 'debug'` yields `''`, not `'debug'`. That exact line left
# `LOG_LEVEL=""` in a working .env.local and pino refused to start: "default level: must
# be included in custom levels". `AUTH_URL=""` is quieter and worse — it makes Auth.js
# compute `trustHost: false`, because it too stops at the first non-nullish value.
# An absent key takes the default. An empty key overrides it with nothing.

# --- Database -------------------------------------------------------------------
# Provisioned by the Supabase marketplace integration: POSTGRES_URL,
# POSTGRES_URL_NON_POOLING, SUPABASE_* and friends arrive automatically.
#
# DATABASE_URL is set by hand and is NOT the Supabase-provided one. It connects as
# the non-owner `healthapp_app` role through the transaction pooler (port 6543,
# username `healthapp_app.<project-ref>`). This matters: Supabase's own `postgres`
# role has rolbypassrls, so connecting as it silently disables every RLS policy and
# the tenancy backstop in DESIGN.md §3.5 stops existing.
DATABASE_URL=

# Only for a self-hosted Postgres. On Supabase, migrations use POSTGRES_URL_NON_POOLING
# automatically, so the owner credential never needs storing separately.
DATABASE_MIGRATION_URL=

# --- Auth -----------------------------------------------------------------------
# Signs and encrypts session cookies. Generate 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Not `npx auth secret` — the bare `auth` package on npm is Better Auth's CLI,
# a different project, and it emits BETTER_AUTH_SECRET.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Redirect URIs must include both:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-deployment>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Extraction -----------------------------------------------------------------
# Required. Reading a document is a Claude call, so without this the scan and import
# paths throw rather than degrading — see adapters/claude/llm.ts. Everything else in
# the app works without it.
#
# Note what this implies: every document you scan is sent to Anthropic. That is the
# egress described in SECURITY.md, and it is the first thing to resolve if you are
# subject to HIPAA, GDPR or Israeli privacy law.
ANTHROPIC_API_KEY=

# --- Misc -----------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# Optional, and off in production on purpose. Appends every log line to
# <LOG_DIR>/healthapp.log as NDJSON, in addition to stdout — useful locally and on a
# self-hosted box, useless on Vercel, whose filesystem is read-only apart from a /tmp
# that dies with the instance.
#
# Point it outside the repository and outside anything served: /var/log/healthapp on a
# host, or a gitignored var/log locally. The lines carry no health content, but they do
# carry space and request ids.
#
# The durable, queryable copy is the app_log table, which needs no configuration and is
# what the שימוש AI tab reads.
#
# Safe to leave empty, unlike the two above: it is read as `process.env.LOG_DIR?.trim()`
# and tested for falsiness, so an empty string means "off" rather than a broken value.
LOG_DIR=

# --- Arrives on its own · nothing to fill in -------------------------------------
# Deploying through the Vercel/Supabase marketplace integration injects about sixteen
# further variables — POSTGRES_*, SUPABASE_*, NEXT_PUBLIC_SUPABASE_*. They are named
# here so their absence above reads as deliberate rather than as an omission.
#
# The app reads exactly one of them: POSTGRES_URL_NON_POOLING, for migrations. The rest
# are ignored, and three are worth being rid of:
#
#   SUPABASE_SERVICE_ROLE_KEY   bypasses RLS entirely — the app never uses it
#   SUPABASE_SECRET_KEY         bypasses RLS entirely — the app never uses it
#   SUPABASE_JWT_SECRET         signs the legacy anon/service_role keys
#
# Deleting them in Vercel does not hold: the integration owns those variables and
# re-injects them. Revoke at Supabase instead — Settings → API Keys for the secret key,
# Settings → JWT for the legacy signing key. See SECURITY.md.
#
# One trap worth naming: do **not** point the app at POSTGRES_URL. That is Supabase's
# owner role, which carries rolbypassrls, so using it silently disables every policy
# while the app keeps working. DATABASE_URL above exists precisely to avoid that, and
# it is the conventional variable name most libraries reach for first.
